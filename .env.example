# Hugging Face Access Token (get yours at https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here

# Hugging Face LLM Model for evidence-grounded comparative analysis
# Examples: Qwen/Qwen2.5-72B-Instruct, meta-llama/Llama-3.3-70B-Instruct, mistralai/Mistral-7B-Instruct-v0.3
HF_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# Embedding Model for BGE-M3 Semantic Similarity
HF_EMBEDDING_MODEL=BAAI/bge-m3

# Allowed CORS Origins for Vercel deployment (Comma-separated)
ALLOWED_ORIGINS=https://hack-xi-red.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Retrieval & Extraction Settings
MAX_SEARCH_RESULTS=5
TOP_K_EVIDENCE=4
HTTP_TIMEOUT=6.0
LOW_MEMORY_MODE=true

# Fallback: if HF_TOKEN is missing or rate-limited, allow fallback to conservative mode
ALLOW_MOCK_FALLBACK=true
